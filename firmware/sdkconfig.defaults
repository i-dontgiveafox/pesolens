# pesos firmware sdkconfig overrides
# CPU at full 240 MHz for inference throughput
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_MHZ=240
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y

# PSRAM enabled in octal mode (XIAO ESP32-S3 Sense has 8 MB OPI PSRAM)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=n

# Brownout detector — keep on but bump threshold so camera+inference peaks don't trip it
CONFIG_ESP_BROWNOUT_DET=y
CONFIG_ESP_BROWNOUT_DET_LVL_SEL_7=y
CONFIG_ESP_BROWNOUT_DET_LVL=7

# Reduce log spam in release builds (Arduino sets its own log level via macros)
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Allow large static buffers in PSRAM
CONFIG_FREERTOS_HZ=1000
